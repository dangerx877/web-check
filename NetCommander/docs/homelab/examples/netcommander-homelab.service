[Unit]
Description=NetCommander homelab platform (API, web dashboard, monitoring)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netcommander
Group=netcommander
Environment=NETCOMMANDER_HOME=/var/lib/netcommander
# The account password is decrypted by systemd at start and exposed only to this service.
LoadCredentialEncrypted=nc-password:/etc/credstore.encrypted/nc-password
ExecStart=/bin/sh -c 'NETCOMMANDER_VAULT_PASSWORD="$(cat "$CREDENTIALS_DIRECTORY/nc-password")" exec /opt/netcommander/bin/netcommander serve --user admin@example.com --unattended'
Restart=on-failure
RestartSec=10
# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/netcommander
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
